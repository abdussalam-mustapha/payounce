{
  "name": "payounce-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network qieTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network qieMainnet",
    "abi": "hardhat build && node scripts/export-abi.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.5",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "hardhat": "^3.22.0",
    "typescript": "^5.9.3",
    "viem": "^2.57.20"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
